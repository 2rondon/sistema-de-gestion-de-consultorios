<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar"></i> Citas Médicas</h2>
    <a href="/citas/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nueva Cita
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Paciente</th>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (citas && citas.length > 0) { %>
                        <% citas.forEach(cita => { %>
                            <tr>
                                <td><%= cita.id %></td>
                                <td><%= cita.nombre %> <%= cita.apellido %></td>
                                <td><%= cita.fecha %></td>
                                <td><%= cita.hora %></td>
                                <td><%= cita.motivo || '-' %></td>
                                <td>
                                    <span class="badge <%= cita.estado === 'pendiente' ? 'bg-warning' : 
                                                      cita.estado === 'confirmada' ? 'bg-info' : 
                                                      cita.estado === 'completada' ? 'bg-success' : 'bg-danger' %>">
                                        <%= cita.estado %>
                                    </span>
                                </td>
                                <td>
                                    <a href="/citas/<%= cita.id %>/edit" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form action="/citas/<%= cita.id %>?_method=DELETE" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-danger delete-confirm">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="text-center">No hay citas registradas</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
