<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-file-medical"></i> Receta Médica</h4>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h5>Datos del Paciente</h5>
                        <p><strong>Nombre:</strong> <%= recipe.nombre %> <%= recipe.apellido %></p>
                        <p><strong>Cédula:</strong> <%= recipe.cedula %></p>
                        <p><strong>Fecha de Nacimiento:</strong> <%= recipe.fecha_nacimiento || 'No registrada' %></p>
                    </div>
                    <div class="col-md-6 text-end">
                        <h5>Datos de la Receta</h5>
                        <p><strong>Fecha:</strong> <%= new Date(recipe.fecha).toLocaleString() %></p>
                        <p><strong>Receta #:</strong> <%= recipe.id %></p>
                    </div>
                </div>
                
                <div class="mb-4">
                    <h5>Diagnóstico</h5>
                    <div class="p-3 bg-light rounded">
                        <%= recipe.diagnostico %>
                    </div>
                </div>
                
                <div class="mb-4">
                    <h5>Medicamentos Recetados</h5>
                    <div class="p-3 bg-light rounded">
                        <%= recipe.medicamentos ? recipe.medicamentos.replace(/\n/g, '<br>') : 'No se recetaron medicamentos' %>
                    </div>
                </div>
                
                <div class="mb-4">
                    <h5>Indicaciones</h5>
                    <div class="p-3 bg-light rounded">
                        <%= recipe.indicaciones ? recipe.indicaciones.replace(/\n/g, '<br>') : 'Sin indicaciones adicionales' %>
                    </div>
                </div>
                
                <div class="text-end">
                    <button onclick="window.print()" class="btn btn-secondary">
                        <i class="bi bi-printer"></i> Imprimir
                    </button>
                    <a href="/recipes" class="btn btn-primary">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>