<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-medical"></i> Recetas Médicas</h2>
    <a href="/recipes/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nueva Receta
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Paciente</th>
                        <th>Diagnóstico</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (recipes && recipes.length > 0) { %>
                        <% recipes.forEach(recipe => { %>
                            <tr>
                                <td><%= recipe.id %></td>
                                <td><%= recipe.nombre %> <%= recipe.apellido %></td>
                                <td><%= recipe.diagnostico.substring(0, 50) %>...</td>
                                <td><%= new Date(recipe.fecha).toLocaleDateString() %></td>
                                <td>
                                    <a href="/recipes/<%= recipe.id %>" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form action="/recipes/<%= recipe.id %>?_method=DELETE" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-danger delete-confirm">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center">No hay recetas registradas</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
