<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reporte de Pacientes - Consultorio Médico</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Arial', sans-serif;
            padding: 20px;
            background: white;
        }
        
        .header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 3px solid #4CAF50;
        }
        
        .header h1 {
            color: #2c3e50;
            margin-bottom: 10px;
        }
        
        .header .fecha {
            color: #7f8c8d;
            font-size: 12px;
        }
        
        .stats-container {
            margin-bottom: 30px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 5px;
        }
        
        .stats-container h3 {
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 16px;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 15px;
        }
        
        .stat-item {
            text-align: center;
            padding: 10px;
            background: white;
            border-radius: 5px;
            border: 1px solid #dee2e6;
        }
        
        .stat-label {
            font-size: 12px;
            color: #6c757d;
            margin-bottom: 5px;
        }
        
        .stat-value {
            font-size: 20px;
            font-weight: bold;
            color: #2c3e50;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-size: 12px;
        }
        
        th {
            background-color: #4CAF50;
            color: white;
            padding: 10px;
            text-align: center;
            border: 1px solid #ddd;
        }
        
        td {
            padding: 8px;
            text-align: center;
            border: 1px solid #ddd;
        }
        
        tr:nth-child(even) {
            background-color: #f2f2f2;
        }
        
        .footer {
            text-align: center;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            color: #7f8c8d;
            font-size: 10px;
        }
        
        .badge {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 10px;
            font-weight: normal;
        }
        
        .badge-success {
            background-color: #28a745;
            color: white;
        }
        
        .badge-warning {
            background-color: #ffc107;
            color: #333;
        }
        
        .badge-info {
            background-color: #17a2b8;
            color: white;
        }
        
        .badge-danger {
            background-color: #dc3545;
            color: white;
        }
        
        .badge-primary {
            background-color: #007bff;
            color: white;
        }
        
        @media print {
            body {
                padding: 0;
                margin: 0;
            }
            .no-print {
                display: none;
            }
            table {
                page-break-inside: avoid;
            }
            tr {
                page-break-inside: avoid;
                page-break-after: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>🏥 Consultorio Médico</h1>
        <h2>Reporte de Pacientes</h2>
        <div class="fecha">📅 Fecha de generación: <%= fecha %></div>
    </div>
    
    <div class="stats-container">
        <h3>📊 Resumen de Estadísticas</h3>
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-label">Total Pacientes</div>
                <div class="stat-value"><%= stats.total_pacientes %></div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Total Citas</div>
                <div class="stat-value"><%= stats.total_citas %></div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Citas Completadas</div>
                <div class="stat-value"><%= stats.citas_completadas %></div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Citas Pendientes</div>
                <div class="stat-value"><%= stats.citas_pendientes %></div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Citas Confirmadas</div>
                <div class="stat-value"><%= stats.citas_confirmadas %></div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Citas Canceladas</div>
                <div class="stat-value"><%= stats.citas_canceladas %></div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Total Recetas</div>
                <div class="stat-value"><%= stats.total_recetas %></div>
            </div>
        </div>
    </div>
    
    <h3>📋 Lista de Pacientes</h3>
    
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Paciente</th>
                <th>Cédula</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Total Citas</th>
                <th>Completadas</th>
                <th>Pendientes</th>
                <th>Confirmadas</th>
                <th>Canceladas</th>
                <th>Receta</th>
            </tr>
        </thead>
        <tbody>
            <% if (pacientes && pacientes.length > 0) { %>
                <% pacientes.forEach((paciente, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td style="text-align: left;"><%= paciente.nombre %> <%= paciente.apellido %></td>
                        <td><%= paciente.cedula %></td>
                        <td><%= paciente.telefono || '-' %></td>
                        <td style="text-align: left;"><%= paciente.email || '-' %></td>
                        <td><strong><%= paciente.total_citas || 0 %></strong></td>
                        <td>
                            <% if (paciente.citas_completadas > 0) { %>
                                <span class="badge badge-success"><%= paciente.citas_completadas %></span>
                            <% } else { %>
                                <%= paciente.citas_completadas || 0 %>
                            <% } %>
                        </td>
                        <td>
                            <% if (paciente.citas_pendientes > 0) { %>
                                <span class="badge badge-warning"><%= paciente.citas_pendientes %></span>
                            <% } else { %>
                                <%= paciente.citas_pendientes || 0 %>
                            <% } %>
                        </td>
                        <td>
                            <% if (paciente.citas_confirmadas > 0) { %>
                                <span class="badge badge-info"><%= paciente.citas_confirmadas %></span>
                            <% } else { %>
                                <%= paciente.citas_confirmadas || 0 %>
                            <% } %>
                        </td>
                        <td>
                            <% if (paciente.citas_canceladas > 0) { %>
                                <span class="badge badge-danger"><%= paciente.citas_canceladas %></span>
                            <% } else { %>
                                <%= paciente.citas_canceladas || 0 %>
                            <% } %>
                        </td>
                        <td>
                            <% if (paciente.total_recetas > 0) { %>
                                <span class="badge badge-primary">Sí (<%= paciente.total_recetas %>)</span>
                            <% } else { %>
                                <span class="badge" style="background:#6c757d; color:white;">No</span>
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="11" style="text-align: center;">No hay pacientes registrados</td>
                </tr>
            <% } %>
        </tbody>
    </table>
    
    <div class="footer">
        <p>Reporte generado automáticamente por el Sistema de Administración de Consultorios Médicos</p>
        <p>© <%= new Date().getFullYear() %> - Todos los derechos reservados</p>
        <p>Este documento es válido como reporte oficial del consultorio</p>
    </div>
    
    <div class="no-print" style="text-align: center; margin-top: 20px;">
        <button onclick="window.print()" style="padding: 10px 20px; background: #4CAF50; color: white; border: none; border-radius: 5px; cursor: pointer;">
            🖨️ Imprimir / Guardar como PDF
        </button>
        <button onclick="window.close()" style="padding: 10px 20px; background: #dc3545; color: white; border: none; border-radius: 5px; cursor: pointer; margin-left: 10px;">
            ❌ Cerrar
        </button>
    </div>
    
    <script>
        // Auto-imprimir al cargar (opcional, descomentar si quieres que se abra el diálogo automáticamente)
        // setTimeout(() => { window.print(); }, 500);
    </script>
</body>
</html>